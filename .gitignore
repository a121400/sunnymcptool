.DS_Store
Thumbs.db

# Go 相关
*.test
*.out
vendor/

# Wails 构建产物
wails_build_output/

# Compiled binaries (root)
sunnynet-mcp

# iOS tool binaries (source only)
ios-tool/*.dylib
ios-tool/sunny-tool
ios-tool/sunny-tool-final
ios-tool/sunny-tool-ios
